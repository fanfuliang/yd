<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yudao.lianying.v1.basicConfig.dao.mapper.SysConfigMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yudao.lianying.v1.basicConfig.dao.SysConfig">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="status" property="status"/>
        <result column="name" property="name"/>
        <result column="value" property="value"/>
    </resultMap>


    <select id="page" resultMap="BaseResultMap">
        select a.*
        from t_sys_config a
        where a.status = 'T'
        <if test="whereLike != null">
            and
            <foreach collection="whereLike.names" index="i" item="name" separator="or" open="(" close=")">
                ${name} like '%${whereLike.value}%'
            </foreach>
        </if>
        <if test="whereInList.size() > 0">
            and
            <foreach collection="whereInList" index="i" item="item" separator="and" open="(" close=")">
                ${item.name} in
                <foreach collection="item.values" index="j" item="value" separator="," open="(" close=")">
                    #{value}
                </foreach>
            </foreach>
        </if>
        <if test="whereEqualsList.size() > 0">
            and
            <foreach collection="whereEqualsList" index="i" item="item" separator="and" open="(" close=")">
                ${item.name} &lt;=&gt; #{item.value}
            </foreach>
        </if>
        <if test="beginTime != null">
            and a.create_time &gt;= #{beginTime}
        </if>
        <if test="endTime != null">
            and a.create_time &lt; #{endTime}
        </if>
        order by
        <foreach collection="orderByList" index="i" item="orderBy">
            ${orderBy},
        </foreach>
        a.create_time desc
    </select>

</mapper>
